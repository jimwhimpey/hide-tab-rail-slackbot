<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Template. install.sh fills in __DIR__ and __NODE_DIR__ and copies the
       result to ~/Library/LaunchAgents. -->
  <key>Label</key>
  <string>hide-tab-rail-slackbot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__DIR__/slack-css.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/hide-tab-rail-slackbot.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hide-tab-rail-slackbot.log</string>
</dict>
</plist>
